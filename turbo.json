{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "@anticapture/indexer#db:*": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "db:push": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "mint": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "codegen": {
      // Never cached: the real input is the live gateful spec, which no hash
      // can see. A run that raced an API deploy would otherwise be replayed
      // on every retry of that commit, and the retry would never refetch.
      "cache": false,
      "inputs": [
        "kubb.config.ts",
        "src/**",
        "$TURBO_ROOT$/apps/api/**",
        "$TURBO_ROOT$/apps/gateful/**",
        "$TURBO_ROOT$/apps/relayer/**",
        "$TURBO_ROOT$/apps/address-enrichment/**"
      ],
      "outputs": ["generated/**"],
      "env": [
        "ANTICAPTURE_API_URL",
        "RAILWAY_ENVIRONMENT_NAME",
        "EXPECTED_GATEFUL_SHA",
        "VERCEL_GIT_COMMIT_SHA",
        "VERCEL_ENV",
        "VERCEL_GIT_PULL_REQUEST_ID",
        "VERCEL_GIT_COMMIT_REF"
      ]
    },
    "@anticapture/client#build": {
      "dependsOn": ["codegen"],
      // Not cached, for the same reason `codegen` isn't: tsup runs with
      // `dts: true`, so the spec fetched at runtime is compiled into `dist`,
      // and no hash can see it. Declaring `generated/**` as an input does not
      // work — turbo hashes inputs before the run, and `generated/` is
      // gitignored, so on a fresh checkout it is empty at that moment and the
      // glob contributes nothing. A retry would re-run codegen and then
      // restore the dist built from the stale spec straight over it.
      "cache": false,
      "outputs": ["dist/**"]
    },
    "@anticapture/client-docs#build": {
      "inputs": [
        "docs/**",
        "src/**",
        "scripts/**",
        "docusaurus.config.ts",
        "sidebars.ts"
      ],
      "outputs": ["build/**"],
      "env": ["ANTICAPTURE_API_URL"]
    },
    "@anticapture/dashboard#build": {
      "dependsOn": ["^codegen", "^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "storybook": {
      "persistent": true,
      "cache": false
    },
    "@anticapture/dashboard#build-storybook": {
      "dependsOn": ["^codegen", "^build"],
      "outputs": ["storybook-static/**"]
    },
    "build-storybook": {
      "outputs": ["storybook-static/**"]
    },
    "start": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "clean": {
      "cache": false
    },
    "//#changeset": {
      "cache": false,
      "interactive": true
    },
    "lint": {
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.js",
        "**/*.jsx",
        "eslint.config.*"
      ]
    },
    "lint:fix": {
      "cache": false,
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.js",
        "**/*.jsx",
        "eslint.config.*"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["**/*.ts", "**/*.tsx", "tsconfig.json", "tsconfig.*.json"]
    },
    "@anticapture/client#typecheck": {
      "dependsOn": ["@anticapture/client#codegen", "^build"],
      "inputs": ["**/*.ts", "**/*.tsx", "tsconfig.json", "tsconfig.*.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.test.*"],
      "passThroughEnv": ["ANTICAPTURE_API_URL"]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.test.*"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "CI",
        "PLAYWRIGHT_BASE_URL",
        "PLAYWRIGHT_PORT",
        "ANTICAPTURE_API_URL",
        "RAILWAY_ENVIRONMENT_NAME",
        "USER_API_URL",
        "NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID",
        "BLOCKFUL_API_TOKEN"
      ]
    },
    "@anticapture/dashboard#test:e2e:headed": {
      "cache": false,
      "passThroughEnv": [
        "CI",
        "PLAYWRIGHT_BASE_URL",
        "PLAYWRIGHT_PORT",
        "ANTICAPTURE_API_URL",
        "USER_API_URL",
        "NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID",
        "BLOCKFUL_API_TOKEN"
      ]
    },
    "@anticapture/dashboard#test:e2e:ui": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "CI",
        "PLAYWRIGHT_BASE_URL",
        "PLAYWRIGHT_PORT",
        "ANTICAPTURE_API_URL",
        "USER_API_URL",
        "NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID",
        "BLOCKFUL_API_TOKEN"
      ]
    },
    "db:generate": {
      "inputs": ["src/**/*.ts"],
      "outputs": ["drizzle/**"]
    },
    "@anticapture/indexer": {
      "env": ["DAO_ID"]
    },
    "@anticapture/api": {
      "env": [
        "DAO_ID",
        "CHAIN_ID",
        "TREASURY_DATA_PROVIDER_API_URL",
        "TREASURY_DATA_PROVIDER_ID"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "@anticapture/client#mcp": {
      "dependsOn": ["@anticapture/client#codegen"],
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "@anticapture/client#mcp-http": {
      "dependsOn": ["@anticapture/client#codegen"],
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "@anticapture/relayer#dev:fork": {
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["*"]
    }
  }
}

{
  "title": "User API Validation",
  "uid": "user-api-validation",
  "editable": true,
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "timezone": "America/Sao_Paulo",
  "tags": ["anticapture", "user-api", "validation"],
  "time": { "from": "now-30d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "People using it",
      "description": "All registered accounts and callers active today (GMT-3).",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "user_api_accounts_total",
          "legendFormat": "Accounts",
          "refId": "A"
        },
        {
          "expr": "sum(user_api_active_users)",
          "legendFormat": "Active today",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "title": "API calls per day",
      "description": "All self-service key calls, including 429 and downstream 5xx.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "sum(increase(tenant_requests_total{tenant=\"user:*\"}[1d]))",
          "legendFormat": "Calls",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Keys",
      "description": "Current live keys and keys created over the trailing day.",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "user_api_keys_live",
          "legendFormat": "Live keys",
          "refId": "A"
        },
        {
          "expr": "increase(user_api_keys_created_total[1d])",
          "legendFormat": "Created / day",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active-user retention by key age",
      "description": "Today's active users bucketed by their newest key age.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "stacking": { "mode": "normal", "group": "A" },
            "fillOpacity": 70
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "user_api_active_users",
          "legendFormat": "{{age_bucket}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Tokens and usage by login method",
      "description": "Current live tokens and API requests recorded today, grouped by account login method.",
      "type": "table",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "expr": "max by (login_method) (user_api_login_method_tokens)",
          "format": "table",
          "instant": true,
          "legendFormat": "{{login_method}}",
          "refId": "A"
        },
        {
          "expr": "max by (login_method) (user_api_login_method_usage_today)",
          "format": "table",
          "instant": true,
          "legendFormat": "{{login_method}}",
          "refId": "B"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "login_method": 0,
              "Value #A": 1,
              "Value #B": 2
            },
            "renameByName": {
              "login_method": "Login method",
              "Value #A": "Tokens",
              "Value #B": "Usage today"
            }
          }
        }
      ]
    }
  ]
}
